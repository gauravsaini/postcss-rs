{
  "name": "postcss-rs",
  "version": "1.0.1",
  "description": "High-performance Rust-based parser for CSS",
  "main": "bridge.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "bridge.js",
    "*.node",
    "README.md"
  ],
  "napi": {
    "binaryName": "index",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "artifacts": "napi artifacts",
    "test": "node test_all.js && node validate.js && node test_fixtures.js && node test_fuzz.js"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0",
    "postcss": "^8.4.38"
  }
}
